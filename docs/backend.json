
{
  "entities": {
    "Class": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Class",
      "type": "object",
      "description": "Represents a class (e.g., 3rd grade, 4th grade, up to 8th grade).",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the class."
        },
        "gradeLevel": {
          "type": "number",
          "description": "The grade level of the class (3-8).",
          "format": "integer"
        }
      },
      "required": [
        "id",
        "gradeLevel"
      ]
    },
    "Subject": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Subject",
      "type": "object",
      "description": "Represents a subject within a class (e.g., Math, Science, History).",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the subject."
        },
        "classId": {
          "type": "string",
          "description": "Reference to Class."
        },
        "name": {
          "type": "string",
          "description": "The name of the subject."
        }
      },
      "required": [
        "id",
        "classId",
        "name"
      ]
    },
    "Chapter": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Chapter",
      "type": "object",
      "description": "Represents a chapter or topic within a subject.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the chapter."
        },
        "subjectId": {
          "type": "string",
          "description": "Reference to Subject."
        },
        "name": {
          "type": "string",
          "description": "The name or title of the chapter."
        }
      },
      "required": [
        "id",
        "subjectId",
        "name"
      ]
    },
    "Resource": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Resource",
      "type": "object",
      "description": "Represents a piece of content associated with a chapter.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the resource."
        },
        "chapterId": {
          "type": "string",
          "description": "Reference to Chapter."
        },
        "title": {
          "type": "string",
          "description": "The name or title of the resource."
        },
        "type": {
          "type": "string",
          "description": "The type of the file."
        },
        "url": {
          "type": "string",
          "description": "The URL of the resource."
        }
      },
      "required": [
        "id",
        "chapterId",
        "title",
        "type",
        "url"
      ]
    },
    "UserActivity": {
      "title": "User Activity",
      "description": "Records a user viewing a resource and duration.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The ID of the user." },
        "userName": { "type": "string", "description": "The name of the user." },
        "userEmail": { "type": "string", "description": "The email of the user." },
        "resourceId": { "type": "string", "description": "The ID of the viewed resource." },
        "resourceTitle": { "type": "string", "description": "The title of the viewed resource." },
        "resourceClass": { "type": "string", "description": "The class of the viewed resource." },
        "resourceSubject": { "type": "string", "description": "The subject of the viewed resource." },
        "resourceChapter": { "type": "string", "description": "The chapter of the viewed resource." },
        "timestamp": { "type": "string", "format": "date-time", "description": "The start time of the activity." },
        "durationSeconds": { "type": "number", "description": "Duration spent on the resource in seconds." }
      },
      "required": ["userId", "userEmail", "userName", "resourceId", "resourceTitle", "timestamp"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous",
      "google.com"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/classes",
        "definition": {
          "entityName": "Class",
          "schema": {
            "$ref": "#/backend/entities/Class"
          },
          "description": "Represents classes."
        }
      },
      {
        "path": "/classes/{classId}/subjects",
        "definition": {
          "entityName": "Subject",
          "schema": {
            "$ref": "#/backend/entities/Subject"
          },
          "description": "Represents subjects within a class."
        }
      },
      {
        "path": "/user-activity",
        "definition": {
          "entityName": "UserActivity",
          "schema": {
            "$ref": "#/backend/entities/UserActivity"
          },
          "description": "Logs user interactions with content resources including duration tracking."
        }
      }
    ],
    "reasoning": "The structure maintains hierarchical content while enabling rich tracking of student engagement through the user-activity collection, including duration metrics for analytics."
  }
}

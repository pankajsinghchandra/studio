
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     */
    match /users/{userId} {
      allow create: if true;
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list: if request.auth != null && request.auth.token.email == 'quizpankaj@gmail.com';
      allow update: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'quizpankaj@gmail.com');
      allow delete: if false;
    }
    
    /**
     * @description Controls access to the 'user-activity' collection.
     * @allow Any authenticated user can create their own logs and update duration.
     * @allow Admin users can read all logs.
     */
    match /user-activity/{activityId} {
      allow create: if request.auth != null;
      // Allow users to update their own duration tracking records
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && request.auth.token.email == 'quizpankaj@gmail.com';
      allow delete: if false;
    }

    /**
     * @description Controls access to the 'resources' collection.
     */
    match /resources/{resourceId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.token.email == 'quizpankaj@gmail.com';
    }

    /**
     * @description Public read access for educational content structure.
     */
    match /classes/{classId} {
      allow read: if true;
      allow write: if false;
    }

    match /classes/{classId}/subjects/{subjectId} {
      allow read: if true;
      allow write: if false;
    }

    match /classes/{classId}/subjects/{subjectId}/chapters/{chapterId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
